{
  "name": "tag-trace",
  "version": "3.90.1",
  "description": "Diagnóstico local, en el navegador, de circuitos AGV a partir de las lecturas de sus tags. Ningún dato sale del dispositivo.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "axe-core": "4.13.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.5"
  }
}
