#!/usr/bin/env bash
# Guardián local de TAG TRACE. Actívalo con:  git config core.hooksPath .githooks
#
# Rechaza en tu máquina lo mismo que rechazaría la integración continua, antes de que
# un dato industrial salga del dispositivo. Ver ADR-0007 y ADR-0014.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
if [ "${#staged[@]}" -eq 0 ]; then
  exit 0
fi

if ! bash scripts/check_data.sh "${staged[@]}"; then
  echo "Commit detenido por el guardián de datos."
  exit 1
fi

changed_docs=0
for file in "${staged[@]}"; do
  case "$file" in
    docs/*|README.md|AGENTS.md|CLAUDE.md|CONTRIBUTING.md|CHANGELOG.md|schemas/*) changed_docs=1 ;;
  esac
done

if [ "$changed_docs" -eq 1 ]; then
  if ! python3 scripts/check_docs.py; then
    echo "Commit detenido por la verificación documental."
    exit 1
  fi
fi
